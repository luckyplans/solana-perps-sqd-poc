DATABASE_PATH=./data/solana-perps-poc.sqlite
MARKETS_PATH=./config/markets.json
HTTP_HOST=127.0.0.1
PORT=3100

# SQD Portal is the historical Solana instruction source. The public endpoint
# does not require a Dune key. Replace this URL with a private/self-hosted
# Portal later without changing the backfill service.
SQD_PORTAL_URL=https://portal.sqd.dev/datasets/solana-mainnet
# Recommended range is 10,000-50,000 slots. Start at 25,000.
SQD_SLOT_BATCH_SIZE=25000
SQD_REQUEST_TIMEOUT_MS=120000
SQD_MAX_RETRIES=10
SQD_RETRY_BASE_MS=1000
SQD_RETRY_MAX_MS=30000
# Immutable local source archive. Each completed slot chunk has a manifest and SHA-256.
SOURCE_ARCHIVE_DIR=./data/source-archive
EVENT_BUILD_BATCH_SIZE=1000

# Conservative pacing for the public development endpoint.
SQD_REQUEST_INTERVAL_MS=650

# Used only for low-volume GMTrade market-account and mint discovery.
# Jupiter historical event ingestion does not require this RPC.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_REQUEST_RETRIES=3
AUTO_SYNC_MARKETS=true

# Optional compact canonical-action archive.
PARQUET_OUTPUT_DIR=./data/parquet
PARQUET_PYTHON_COMMAND=python3
PARQUET_BATCH_SIZE=100000
PARQUET_AUTO_EXPORT=false
